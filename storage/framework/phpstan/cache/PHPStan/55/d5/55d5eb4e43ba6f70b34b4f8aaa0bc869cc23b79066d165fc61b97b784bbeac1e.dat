O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.5.10-dffeb8336e52ea8db0b513635207d0f9446b5c95c5f0252d5c9ca8f729a1dd73";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:40:"App\Console\Command\SeedBenchmarkProject";s:8:"filename";s:71:"C:/xampp/htdocs/proyekArsi/app/Console/Command/SeedBenchmarkProject.php";}}s:9:"namespace";s:19:"App\Console\Command";s:4:"name";s:40:"App\Console\Command\SeedBenchmarkProject";s:9:"shortName";s:20:"SeedBenchmarkProject";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:810:"/**
 * Benchmark harness (PRD §8.6 / §9 performance target: recalculate + render
 * 500 tasks in under 1 second).
 *
 * Creates a deterministic 500-task project on the configured (MySQL) database:
 *   - 450 leaf tasks in 50 groups of 9, FS-chained inside each group,
 *     SS links between groups, lags, plus 1 in 10 tasks with a start input
 *   - 50 computed parent tasks
 *   - 300 dependencies, 10 members with leaves, ~150 assignments
 *
 * It then measures:
 *   1. cold recalculation (full persistence pass)
 *   2. warm recalculation (no data change, same project)
 *   3. task-list render time (Livewire render data, not HTML string)
 *   4. number of DB queries issued by both, to expose N+1 patterns.
 *
 * Usage: php artisan benchmark:seed-500 {--fresh : delete the benchmark project first}
