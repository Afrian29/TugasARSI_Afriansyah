 * Recalculate a whole project schedule.
 *
 * Rules implemented:
 *  - Duration is counted in working days; end = start + (duration - 1) (PRD §8.1/§8.3).
 *  - A start falling on a non-working day moves to the next working day (TSK-1 AC).
 *  - Effective start = max(adjusted requested start, all predecessor constraints) (PRD §8.2).
 *  - FS with lag L: successor starts L+1 working days after predecessor finish (D-07).
 *  - SS with lag L: successor starts L working days after predecessor start (D-07).
 *  - Parent tasks roll up: start = earliest child start, end = latest child end (TSK-4).
 *  - Slack = working days between early and late start; critical when slack <= 0 (CPM-2, D-25).
 *
 * @throws SchedulingException|CircularDependencyException
 */";s:9:"startLine";i:32;s:7:"endLine";i:76;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:21:"App\Domain\Scheduling";s:18:"declaringClassName";s:36:"App\Domain\Scheduling\ScheduleEngine";s:21:"implementingClassName";s:36:"App\Domain\Scheduling\ScheduleEngine";s:16:"currentClassName";s:36:"App\Domain\Scheduling\ScheduleEngine";s:9:"aliasName";N;}s:10:"indexTasks";a:20:{s:4:"name";s:10:"indexTasks";s:10:"parameters";a:1:{s:8:"taskList";a:13:{s:4:"name";s:8:"taskList";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:82;s:7:"endLine";i:82;s:11:"startColumn";i:33;s:9:"endColumn";i:47;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:90:"/**
