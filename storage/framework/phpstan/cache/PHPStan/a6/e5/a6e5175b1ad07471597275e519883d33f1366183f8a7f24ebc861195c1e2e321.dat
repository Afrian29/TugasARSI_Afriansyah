O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:83:"v3-6.73.0.6-8.5.10-157f10d7faf2e1242c9555686cb2a8c20c28c3f1a3e3c0072969a3670e1b9bc8";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:60:"PHPStan\BetterReflection\SourceLocator\Located\LocatedSource";s:4:"data";a:2:{s:4:"name";s:38:"App\Domain\Workload\WorkloadCalculator";s:8:"filename";s:69:"C:/xampp/htdocs/proyekArsi/app/Domain/Workload/WorkloadCalculator.php";}}s:9:"namespace";s:19:"App\Domain\Workload";s:4:"name";s:38:"App\Domain\Workload\WorkloadCalculator";s:9:"shortName";s:18:"WorkloadCalculator";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:32;s:10:"docComment";s:1051:"/**
 * Pure workload calculator for the "Resource Chart" additional feature.
 *
 * Shows how loaded each team member is over time so a PM can spot
 * overallocation and idle capacity. It only reports — it never moves tasks
 * (no resource leveling).
 *
 * Same rules as the scheduling engine (D-05): no Eloquent, no facades, no
 * HTTP — deterministic input/output only.
 *
 * Rules implemented (Resource Chart part 1):
 *  - Parent tasks are never counted; only leaf tasks.
 *  - A task assigned to several members counts fully for each member.
 *  - load(day) = sum of the allocation percent of active assigned tasks.
 *  - capacity(day) = 100 on working days; 0 on weekends, holidays and the
 *    member's leave days.
 *  - overallocated = load > capacity (therefore a task spanning a weekend or
 *    holiday — where capacity is 0 — is reported on those days too: work
 *    sitting on a non-working day is a conflict the PM should see).
 *  - leaveConflict = member is on leave that day AND an assigned task is
 *    active that day.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:33;s:7:"endLine";i:217;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:2:{s:14:"MAX_RANGE_DAYS";a:12:{s:18:"declaringClassName";s:38:"App\Domain\Workload\WorkloadCalculator";s:21:"implementingClassName";s:38:"App\Domain\Workload\WorkloadCalculator";s:4:"name";s:14:"MAX_RANGE_DAYS";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:5:"36600";s:10:"attributes";a:6:{s:9:"startLine";i:36;s:7:"endLine";i:36;s:13:"startTokenPos";i:50;s:12:"startFilePos";i:1378;s:11:"endTokenPos";i:50;s:10:"endFilePos";i:1383;}}s:10:"docComment";s:91:"/** Hard cap on the calculated date range (100 years) — guards against nonsense input. */";s:10:"attributes";a:0:{}s:9:"startLine";i:36;s:7:"endLine";i:36;s:11:"startColumn";i:5;s:9:"endColumn";i:42;}s:21:"UNASSIGNED_ALLOCATION";a:12:{s:18:"declaringClassName";s:38:"App\Domain\Workload\WorkloadCalculator";s:21:"implementingClassName";s:38:"App\Domain\Workload\WorkloadCalculator";s:4:"name";s:21:"UNASSIGNED_ALLOCATION";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:3:"100";s:10:"attributes";a:6:{s:9:"startLine";i:39;s:7:"endLine";i:39;s:13:"startTokenPos";i:63;s:12:"startFilePos";i:1515;s:11:"endTokenPos";i:63;s:10:"endFilePos";i:1517;}}s:10:"docComment";s:81:"/** Load contributed by a task nobody is assigned to (the default allocation). */";s:10:"attributes";a:0:{}s:9:"startLine";i:39;s:7:"endLine";i:39;s:11:"startColumn";i:5;s:9:"endColumn";i:46;}}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:1:{s:9:"calculate";a:20:{s:4:"name";s:9:"calculate";s:10:"parameters";a:4:{s:5:"tasks";a:13:{s:4:"name";s:5:"tasks";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attrib